# Copy to .env and fill in. The server reads .env on start.

# Required for the Chat / AI Journey tabs. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Path to your Obsidian vault (source of truth for quest/goal state).
VAULT_PATH=/home/jaybytestech/Documents/Necronomicon

# Where in the vault the durable hub state lives.
STATE_REL=Gaming/OSRS/OSRS Hub State.md

# Progress history file (auto-written daily from the Hiscores).
HISTORY_REL=Gaming/OSRS/OSRS Hiscores History.md

# OSRS display name for live Hiscores stats (no API key needed).
RSN=Nullyn Voyd

# Chat model. Use claude-sonnet-4-6 for cheaper/faster chat, claude-opus-4-8 for best quality.
MODEL=claude-opus-4-8

# Set to false if your account doesn't have the web search tool enabled.
ENABLE_WEB_SEARCH=true

# Port for the local server.
PORT=5173

# SQLite database file (structured/time-series data: history, accounts).
# Defaults to data/osrs-hub.db in the project root. The vault stays for human notes.
# DB_PATH=data/osrs-hub.db

# Optional shared secret for the passive telemetry endpoint (POST /api/ingest).
# If set, RuneLite webhooks (e.g. Dink) must append ?token=<value> to the ingest URL.
# Leave blank to accept any local POST (fine for a personal localhost-only setup).
# INGEST_TOKEN=
